# 将本文件复制为 .env，再填写自己的 DeepSeek API Key。
# 真实 .env 含有密钥，绝对不能提交到 Git。

MINI_DEER_MODEL_PROVIDER=openai-compatible
MINI_DEER_MODEL_NAME=deepseek-v4-flash
MINI_DEER_API_KEY=

# DeepSeek 官方的 OpenAI 兼容接口地址。
MINI_DEER_API_BASE_URL=https://api.deepseek.com

# SQLite 仅用于当前本地阶段；生产环境以后通过 persistence adapter 替换。
MINI_DEER_CHECKPOINT_DATABASE_PATH=data/checkpoints.sqlite
MINI_DEER_APPLICATION_DATABASE_PATH=data/application.sqlite
