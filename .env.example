# 将本文件复制为 .env，再填写自己的 DeepSeek API Key。
# 真实 .env 含有密钥，绝对不能提交到 Git。

MINI_DEER_MODEL_PROVIDER=openai-compatible
MINI_DEER_MODEL_NAME=deepseek-v4-flash
MINI_DEER_API_KEY=

# DeepSeek 官方的 OpenAI 兼容接口地址。
MINI_DEER_API_BASE_URL=https://api.deepseek.com

# SQLite 仅用于当前本地阶段；生产环境以后通过 persistence adapter 替换。
MINI_DEER_CHECKPOINT_DATABASE_PATH=data/checkpoints.sqlite
MINI_DEER_APPLICATION_DATABASE_PATH=data/application.sqlite

# 13.1 项目登记默认关闭。目录是后端运行机器上的目录；JSON 数组使用正斜杠。
# 示例：MINI_DEER_WORKSPACE_ALLOWED_ROOTS=["D:/project/workspace-samples"]
MINI_DEER_WORKSPACE_ALLOWED_ROOTS=[]
# 本地学习模式无需工作区密码；修改允许目录后重启后端。

# 长对话自动摘要只压缩 Agent checkpoint，不删除页面历史。
MINI_DEER_CONTEXT_SUMMARY_ENABLED=true
MINI_DEER_CONTEXT_SUMMARY_TRIGGER_TOKENS=50000
MINI_DEER_CONTEXT_SUMMARY_TRIGGER_MESSAGES=40
MINI_DEER_CONTEXT_SUMMARY_KEEP_MESSAGES=10
MINI_DEER_CONTEXT_SUMMARY_INPUT_TOKENS=25000

# MCP 默认读取 mcp_servers.json；本地学习示例可改为 mcp_servers.example.json。
# 修改 MCP 配置后需要重启后端，启动状态见 GET /api/v1/mcp/status。
MINI_DEER_MCP_CONFIG_PATH=mcp_servers.json
MINI_DEER_MCP_SERVER_INIT_TIMEOUT_SECONDS=10
